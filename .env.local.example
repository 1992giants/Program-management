# production 운영 DB는 서버 PC의 로컬 디스크에 두세요.
ONMAEUM_DB_PATH=C:\OnmaeumProgramCare\data\onmaeum.sqlite

# development는 운영 DB 변수를 사용하지 않습니다. 필요할 때 별도 경로를 지정하세요.
ONMAEUM_DEV_DB_PATH=C:\OnmaeumProgramCare\data\development.sqlite

# 백업은 외장하드·NAS 공유 폴더로 분리할 수 있습니다.
ONMAEUM_BACKUP_DIR=E:\OnmaeumProgramCareBackups
# ONMAEUM_BACKUP_DIR=\\CENTER-SERVER\ProgramBackups

# 신규 DB 초기화 또는 명시적 USR-ADMIN migration 때만 아래 세 값을 모두 설정하세요.
# one-shot 명령이 끝나면 이 값을 제거한 뒤 서버를 별도로 시작하세요.
# ONMAEUM_BOOTSTRAP_ADMIN_USERNAME=center-admin
# ONMAEUM_BOOTSTRAP_ADMIN_DISPLAY_NAME=센터 관리자
# ONMAEUM_BOOTSTRAP_ADMIN_PIN=직접_정한_8자리_이상_PIN

# 아래 maintenance 명령은 DB 작업 후 종료하며 웹서버를 시작하지 않습니다.
# 신규 production DB 생성은 start-center.ps1의 -InitializeProductionDatabase로만 수행하세요.
# 기존 marker 없는 DB는 백업·경로 확인 후 -AdoptProductionDatabase를 한 번만 사용하세요.
# 기존 USR-ADMIN은 백업 후 -MigrateUsrAdmin을 한 번만 사용해 같은 ID로 전환하세요.

# 개발용 더미 데이터는 development에서 명시적으로 1을 지정한 경우에만 생성됩니다.
ONMAEUM_ENABLE_DEMO_SEED=0
